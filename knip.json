{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreDependencies": ["pngjs", "@types/pngjs"],
  "ignore": [
    "server/src/providers/file/hooks/claude-hook.ts"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "tui/src/index.ts"
      ],
      "project": [
        "tui/src/**/*.ts",
        "shared/**/*.ts",
        "webview-ui/src/**/*.ts"
      ]
    },
    "server": {
      "entry": [
        "src/server.ts",
        "__tests__/**/*.ts"
      ],
      "project": [
        "src/**/*.ts",
        "__tests__/**/*.ts"
      ]
    }
  }
}
