{
  "name": "tui-pixel-agents",
  "displayName": "TUI Pixel Agents",
  "description": "Terminal UI pixel art office where your Claude Code agents come to life as animated characters",
  "version": "1.2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/jeremy-vm/tui-pixel-agents"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "cd tui && npm run build",
    "dev": "cd tui && npm run dev",
    "start": "cd tui && npm run start",
    "check-types": "tsc --noEmit && tsc --noEmit -p server/tsconfig.test.json",
    "prepare": "husky",
    "lint": "eslint server tui/src webview-ui/src",
    "lint:fix": "eslint server tui/src webview-ui/src --fix",
    "format": "prettier --write \"server/**/*.ts\" \"tui/src/**/*.ts\" \"webview-ui/src/**/*.{ts,tsx}\" \"shared/**/*.ts\" \"*.{js,mjs,json,md}\"",
    "format:check": "prettier --check \"server/**/*.ts\" \"tui/src/**/*.ts\" \"webview-ui/src/**/*.{ts,tsx}\" \"shared/**/*.ts\" \"*.{js,mjs,json,md}\"",
    "test:server": "cd server && npm test",
    "test": "npm run test:server",
    "knip": "knip"
  },
  "devDependencies": {
    "@types/node": "25.x",
    "@types/pngjs": "^6.0.5",
    "esbuild": "^0.28.0",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "husky": "^9.1.7",
    "knip": "^6.3.0",
    "lint-staged": "^16.3.2",
    "npm-run-all": "^4.1.5",
    "pngjs": "^7.0.0",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0"
  },
  "lint-staged": {
    "server/**/*.ts": "eslint --fix",
    "tui/src/**/*.ts": "eslint --fix",
    "webview-ui/src/**/*.{ts,tsx}": "eslint --fix",
    "*.{ts,tsx,js,mjs,css,json,md}": "prettier --write"
  }
}
